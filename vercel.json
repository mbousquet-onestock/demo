{
  "functions": {
    "api/proxy.ts": {
      "maxDuration": 60
    },
    "api/data.ts": {
      "maxDuration": 30
    },
    "api/ai.ts": {
      "maxDuration": 60
    },
    "api/image.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/img/:file",
      "destination": "/api/image?id=:file"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
